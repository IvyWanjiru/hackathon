# Copy this file to .env and edit it privately. Never paste credentials into chat.
# .env is ignored by Git and Docker. Render uses its private Environment settings.

# Live-workspace access: use a random signing key (at least 32 characters)
# and a strong workspace password (at least 12 characters).
GHOST_SECRET_KEY=
GHOST_ADMIN_PASSWORD=

# Your existing Render service's PUBLIC HTTPS address, with no trailing path.
# Leave blank for Gmail-only testing on localhost.
GHOST_PUBLIC_URL=

# Meta WhatsApp Cloud API: app secret, selected phone-number ID,
# and a random verification token shared with Meta's webhook configuration.
# No WhatsApp access token is needed for this receive-only webhook.
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# Gmail: a dedicated presentation mailbox or the GhostDemandDemo label.
# Use an app password, NEVER your normal Google password.
GHOST_GMAIL_ACCOUNT=
GHOST_GMAIL_APP_PASSWORD=
GHOST_GMAIL_FOLDER=GhostDemandDemo
GHOST_GMAIL_ENABLED=1
GHOST_GMAIL_POLL_SECONDS=15

# Keep live and synthetic demo data separate. Optional defaults:
# GHOST_DB=/path/to/persistent/ghostdemand.db
# GHOST_DEMO_DB=/path/to/persistent/ghostdemand-demo.db
